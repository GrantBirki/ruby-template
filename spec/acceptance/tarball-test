#!/usr/bin/env bash

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && cd ../.. && pwd)"
source "$HERE/script/env" "$@"

cd "$DIR"

# set BUILD_SHA if it is not already set
: "${BUILD_SHA:=$(git rev-parse HEAD)}"

tarball_path=""
tarball_count=0
for candidate in "$TARBALL_DIR"/*-"$BUILD_SHA".tar.gz; do
  [[ -f "$candidate" ]] || continue
  tarball_path="$candidate"
  tarball_count=$((tarball_count + 1))
done

if [[ "$tarball_count" -ne 1 ]]; then
  echo "Expected one tarball for $BUILD_SHA, found $tarball_count" >&2
  exit 1
fi

tarball_relative_path="${tarball_path#"$DIR/"}"

docker build --file spec/acceptance/Dockerfile.tarball --build-arg "TARBALL=$tarball_relative_path" -t "$REPO_NAME-tarball-test:latest" .

# Run the container and capture the output
result=$(docker run --rm "$REPO_NAME-tarball-test:latest" bash -c "/app/script/server --production")

# Check if the result is exactly 3
if [[ "$result" == "3" ]]; then
  echo -e "\n✅ Test passed: Output is 3 as expected"
  exit 0
else
  echo -e "\n❌ Test failed: Expected output to be 3, but got: $result"
  exit 1
fi
